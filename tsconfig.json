{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": [
    "node_modules",
    "migrations/relations.ts",
    "src/components/editor/components/BlockEditor",
    "src/components/editor/components/TableOfContents",
    "src/components/editor/components/menus",
    "src/components/editor/components/panels",
    "src/components/editor/extensions",
    "src/components/editor/ui",
    "src/components/editor/HeaderOptions.tsx",
    "src/components/editor/Room.tsx",
    "src/components/editor/index.tsx"
  ]
}

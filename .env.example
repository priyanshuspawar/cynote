# Copy to .env and fill in. Never commit .env.

# --- Supabase (Project Settings → API) ---
# Public values: inlined into the browser bundle, so they must be set at BUILD time.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Postgres via the Transaction pooler (Connect → Transaction pooler, port 6543).
# URL-encode special characters in the password (@ → %40, # → %23, / → %2F).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- App ---
# Local: http://localhost:3000 · Production: your deployed domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI worker (cloudflare-workers-cypress) ---
# Local: http://127.0.0.1:8787 · Production: https://cynote-ai-worker.<your-subdomain>.workers.dev
NEXT_PUBLIC_EDITOR_GPT_URL=http://127.0.0.1:8787

# --- Liveblocks (dashboard → API keys; use production keys when deploying) ---
NEXT_PUBLIC_LIVEBLOCKS_PUBLIC_KEY=pk_<liveblocks-public-key>
LIVEBLOCKS_PRIVATE_KEY=sk_<liveblocks-secret-key>
